# 具身数据平台 · 部署配置（安装脚本会生成 .env，按需修改后执行 ./edpctl restart）
EDP_VERSION=__VERSION__
# 网页端口：浏览器访问 http://<服务器IP>:8765
EDP_PORT=8765
# 平台数据目录（数据库、处理结果、预览、许可证、备份）
EDP_DATA_DIR=/opt/edp/data
# 原始录制所在目录（只读挂载）：网页“导入”里只能选这个目录下的文件夹
EDP_IMPORT_DIR=/opt/edp/imports
# 导出数据集写到哪里（可以直接指到训练用的存储）
EDP_EXPORT_DIR=/opt/edp/exports
# 外部大模型接口：0 = 禁止（数据不出内网），1 = 允许，留空 = 由管理员在网页设置里决定
EDP_ALLOW_EXTERNAL=
# worker 用哪些显卡：all 或 0,1
EDP_GPUS=all
# 通过 HTTPS 反向代理访问时设为 1
EDP_HTTPS=0
# 可选的内网大模型服务（docker compose --profile vlm up -d）
EDP_MODEL_DIR=/opt/edp/models
EDP_VLM_MODEL=Qwen2.5-VL-7B-Instruct
EDP_VLM_GPU_MEM=0.45
